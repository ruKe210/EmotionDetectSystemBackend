# 情绪识别管理系统后端环境变量配置

# 应用配置
DEBUG=true
APP_NAME=情绪识别管理系统
APP_VERSION=1.0.0

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 跨域配置（多个用逗号分隔）
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

# JWT配置
SECRET_KEY=emotion-detect-secret-key-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 视频流配置
VIDEO_FPS=15
VIDEO_WIDTH=640
VIDEO_HEIGHT=480
MAX_STREAMS=8

# 人脸检测配置
FACE_DETECTION_CONFIDENCE=0.85
MIN_FACE_SIZE=32
MAX_FACES_PER_FRAME=10

# 情绪识别配置
EMOTION_MODEL_PATH=models/emotion_model.pth

# 数据存储配置
DATA_STORAGE_PATH=data/storage
LOG_PATH=data/logs

# 火山方舟（OpenAI 兼容）智能分析配置
VIDEO_RECORD_SEGMENT_SECONDS=60
RECOGNITION_MODEL_TYPE=discrete
RECOGNITION_DELAY_THRESHOLD=200
RECOGNITION_ACCURACY_THRESHOLD=0.7
RECOGNITION_EMOTION_CHANGE_THRESHOLD=0.2
STORAGE_PERIOD_DAYS=30
STORAGE_AUTO_BACKUP=true
STORAGE_BACKUP_FREQUENCY=weekly
PERMISSION_DEFAULT_ROLE=admin
PERMISSION_DEFAULT_ACTIONS=参数配置,数据导出,告警处理,设备管理,用户管理
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=
